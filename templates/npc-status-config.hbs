<form class="fab-status-config-form" autocomplete="off">

  {{#if isBuiltIn}}
    <div class="fab-notice fab-notice-info">
      <i class="fas fa-info-circle"></i>
      <strong>{{builtInDef.name}}</strong> is in the built-in registry. Effects are pre-configured.
    </div>
  {{/if}}

  <fieldset>
    <legend>Feature</legend>
    <div class="form-group">
      <label>Feature</label>
      <span class="fab-readonly">{{item.name}}</span>
    </div>
    <div class="form-group">
      <label>LID</label>
      <span class="fab-readonly fab-mono">{{lid}}</span>
    </div>
    {{#if effectText}}
      <div class="form-group fab-effect-text-group">
        <label>Effect Text</label>
        <div class="fab-effect-text">{{effectText}}</div>
      </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>Status Config</legend>
    <div class="form-group">
      <label>Status Name</label>
      <input type="text" name="name" value="{{currentName}}" placeholder="e.g. Eye of Midnight Active" />
    </div>
    <div class="form-group">
      <label>Icon</label>
      <select name="iconKey">
        {{#each iconOptions}}
          <option value="{{this.value}}" {{#if (eq this.value ../currentIcon)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Status Lives On</label>
      <select name="where">
        {{#each statusWhereOptions}}
          <option value="{{this.value}}" {{#if (eq this.value ../currentWhere)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Status Type</label>
      <select name="statusType">
        {{#each statusTypeOptions}}
          <option value="{{this.value}}" {{#if (eq this.value ../currentStatusType)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Description</label>
      <input type="text" name="description" value="{{currentDescription}}" placeholder="Short description of what happens while active" />
    </div>
  </fieldset>

  {{#if hasNlSuggestions}}
    <fieldset>
      <legend>Auto-Detected Effects</legend>
      <p class="fab-hint">Based on the feature's effect text. Click to add.</p>
      {{#each nlSuggestions}}
        <div class="fab-suggestion">
          <button type="button" class="fab-apply-suggestion" data-index="{{@index}}" title="Add this effect">
            <i class="fas fa-plus"></i>
          </button>
          <span class="fab-suggestion-label">{{this.label}}</span>
          <span class="fab-suggestion-match">"{{this.matchedText}}"</span>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  <fieldset>
    <legend>Effects</legend>
    <div class="fab-effects-list">
      {{#each currentEffects}}
        {{!-- Rendered by JS for existing effects --}}
      {{/each}}
    </div>
    <div class="fab-add-effect-row">
      <select name="newEffectType" class="fab-new-effect-select">
        <option value="">Add effect...</option>
        {{#each effectTypeOptions}}
          <option value="{{this.value}}">{{this.label}} — {{this.description}}</option>
        {{/each}}
      </select>
      <button type="button" class="fab-add-effect" title="Add effect">
        <i class="fas fa-plus"></i> Add
      </button>
    </div>
  </fieldset>

  {{#if existing}}
    <div class="fab-danger-zone">
      <button type="button" class="fab-delete-custom">
        <i class="fas fa-trash"></i> Remove Custom Tracking
      </button>
    </div>
  {{/if}}

</form>
