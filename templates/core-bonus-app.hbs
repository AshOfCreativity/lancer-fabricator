<div class="fabricator-core-bonuses">
  <div class="fabricator-header">
    <h2><i class="fas fa-microchip"></i> {{actor.name}} — Core Bonuses</h2>
  </div>

  {{#if hasCoreBonuses}}
    {{#each coreBonuses}}
    <div class="fabricator-cb-card" data-cb-id="{{this.id}}">
      <div class="fabricator-cb-row">
        <img class="fabricator-cb-img" src="{{this.img}}" alt="{{this.name}}" />
        <div class="fabricator-cb-info">
          <span class="fabricator-cb-name">{{this.name}}</span>
          {{#if this.manufacturer}}<span class="fabricator-cb-mfr">{{this.manufacturer}}</span>{{/if}}
        </div>
        <button class="fabricator-cb-post" data-cb-id="{{this.id}}" title="Post to chat">
          <i class="fas fa-comment"></i>
        </button>
      </div>
      <div class="fabricator-cb-effect">{{{this.effect}}}</div>
      {{#if this.mountedEffect}}
        <div class="fabricator-cb-mounted"><strong>Mounted:</strong> {{{this.mountedEffect}}}</div>
      {{/if}}
    </div>
    {{/each}}
  {{else}}
    <div class="fabricator-cb-empty">
      <p>No core bonuses found on this pilot.</p>
      <p class="hint">{{pilotName}}</p>
    </div>
  {{/if}}
</div>
